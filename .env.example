# Database connection settings (OPTIONAL - future extension only).
#
# The graduation project itself runs entirely on the built-in synthetic data
# generator and does NOT need a database. These settings exist so that the
# evaluation framework can later be connected to a real replenishment
# system's data source.
#
# Copy this file to ".env" and fill in real values locally.
# The .env file is git-ignored: real credentials must NEVER be committed.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public
